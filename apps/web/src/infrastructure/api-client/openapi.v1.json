{
  "openapi": "3.1.0",
  "info": {
    "title": "Luca API",
    "description": "API sin estado para servicios auxiliares de Luca (visión, etiquetado y clima).",
    "version": "0.8.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vision/analyze": {
      "post": {
        "tags": [
          "vision"
        ],
        "summary": "Recorta fondo, extrae color dominante CIELAB y opcionalmente etiqueta la prenda",
        "operationId": "analyze_garment_photo_v1_vision_analyze_post",
        "parameters": [
          {
            "name": "X-Luca-Install-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Luca-Install-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_garment_photo_v1_vision_analyze_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisionAnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/weather": {
      "get": {
        "tags": [
          "weather"
        ],
        "summary": "Consulta el clima actual usando coordenadas redondeadas (~10 km)",
        "operationId": "get_current_weather_v1_weather_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "Latitud aproximada",
              "title": "Lat"
            },
            "description": "Latitud aproximada"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "Longitud aproximada",
              "title": "Lon"
            },
            "description": "Longitud aproximada"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_analyze_garment_photo_v1_vision_analyze_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Foto frontal reducida de la prenda sin EXIF"
          },
          "back_file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Back File",
            "description": "Foto trasera opcional de la prenda sin EXIF"
          },
          "include_tags": {
            "type": "boolean",
            "title": "Include Tags",
            "description": "Si es true, sugiere etiquetas estructuradas vía puerto Tagger",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_garment_photo_v1_vision_analyze_post"
      },
      "GarmentTagSuggestion": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "tshirt",
              "long_sleeve",
              "jacket",
              "pants",
              "shorts",
              "skirt",
              "dress"
            ],
            "title": "Category"
          },
          "category_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Category Confidence"
          },
          "pattern": {
            "type": "string",
            "enum": [
              "solid",
              "striped",
              "plaid",
              "floral",
              "graphic",
              "textured",
              "other"
            ],
            "title": "Pattern"
          },
          "pattern_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Pattern Confidence"
          },
          "style": {
            "type": "string",
            "enum": [
              "casual",
              "minimalist",
              "sporty",
              "formal",
              "streetwear",
              "classic",
              "bohemian"
            ],
            "title": "Style"
          },
          "style_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Style Confidence"
          },
          "formality": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Formality"
          },
          "formality_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Formality Confidence"
          },
          "seasons": {
            "items": {
              "type": "string",
              "enum": [
                "spring",
                "summer",
                "autumn",
                "winter"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Seasons"
          },
          "seasons_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Seasons Confidence"
          },
          "suggested_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Suggested Tags"
          },
          "overall_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Overall Confidence"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "unknown"
          }
        },
        "type": "object",
        "required": [
          "category",
          "category_confidence",
          "pattern",
          "pattern_confidence",
          "style",
          "style_confidence",
          "formality",
          "formality_confidence",
          "seasons",
          "seasons_confidence",
          "overall_confidence"
        ],
        "title": "GarmentTagSuggestion",
        "description": "Salida JSON estructurada del puerto Tagger (RF-11 / T7.1)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "const": "luca-api",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "vision_provider": {
            "type": "string",
            "title": "Vision Provider"
          },
          "tagger_provider": {
            "type": "string",
            "title": "Tagger Provider"
          },
          "weather_provider": {
            "type": "string",
            "title": "Weather Provider"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "vision_provider",
          "tagger_provider",
          "weather_provider"
        ],
        "title": "HealthResponse"
      },
      "LabColorSchema": {
        "properties": {
          "l": {
            "type": "number",
            "title": "L",
            "description": "Luminosidad CIELAB L* (0..100)"
          },
          "a": {
            "type": "number",
            "title": "A",
            "description": "Eje verde-rojo CIELAB a*"
          },
          "b": {
            "type": "number",
            "title": "B",
            "description": "Eje azul-amarillo CIELAB b*"
          }
        },
        "type": "object",
        "required": [
          "l",
          "a",
          "b"
        ],
        "title": "LabColorSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisionAnalyzeResponse": {
        "properties": {
          "cutout_png_base64": {
            "type": "string",
            "title": "Cutout Png Base64",
            "description": "Imagen PNG RGBA frontal recortada en Base64"
          },
          "back_cutout_png_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Back Cutout Png Base64",
            "description": "Imagen PNG RGBA trasera recortada en Base64 (si se envió foto de espalda)"
          },
          "width": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Height"
          },
          "dominant_color_hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Dominant Color Hex"
          },
          "dominant_color_lab": {
            "$ref": "#/components/schemas/LabColorSchema"
          },
          "palette_hex": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Palette Hex"
          },
          "coverage": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coverage"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "processing_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Processing Ms"
          },
          "tagging": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GarmentTagSuggestion"
              },
              {
                "type": "null"
              }
            ],
            "description": "Etiquetas sugeridas con confianza por el puerto Tagger (si include_tags=true)"
          },
          "tagging_warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tagging Warning",
            "description": "Aviso no bloqueante si el proveedor de etiquetado IA no respondió a tiempo"
          }
        },
        "type": "object",
        "required": [
          "cutout_png_base64",
          "width",
          "height",
          "dominant_color_hex",
          "dominant_color_lab",
          "palette_hex",
          "coverage",
          "provider",
          "processing_ms"
        ],
        "title": "VisionAnalyzeResponse"
      },
      "WeatherSummary": {
        "properties": {
          "temperature_c": {
            "type": "number",
            "title": "Temperature C",
            "description": "Temperatura actual estimada en °C"
          },
          "apparent_temperature_c": {
            "type": "number",
            "title": "Apparent Temperature C",
            "description": "Sensación térmica estimada en °C"
          },
          "precipitation_probability": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Precipitation Probability"
          },
          "condition": {
            "type": "string",
            "title": "Condition",
            "description": "Descripción corta del estado del clima en español"
          },
          "rounded_lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Rounded Lat"
          },
          "rounded_lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Rounded Lon"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          }
        },
        "type": "object",
        "required": [
          "temperature_c",
          "apparent_temperature_c",
          "precipitation_probability",
          "condition",
          "rounded_lat",
          "rounded_lon",
          "provider"
        ],
        "title": "WeatherSummary",
        "description": "Resumen climático mínimo sin almacenar ni registrar coordenadas exactas."
      }
    }
  }
}
