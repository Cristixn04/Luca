{
  "name": "luca-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Luca: Smart closet, 3-view fit tester and color advisor",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @luca/domain build && pnpm --filter web build",
    "test": "pnpm --recursive run test",
    "test:coverage": "pnpm --recursive run test:coverage",
    "e2e": "pnpm --filter web e2e",
    "typecheck": "pnpm --filter @luca/domain build && pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^10.15.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
