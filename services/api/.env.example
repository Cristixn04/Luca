# Copia este archivo a services/api/.env y completa tu clave local (nunca subir .env a Git)
LUCA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:4173
LUCA_VISION_PROVIDER=auto

# Etiquetado asistido con Gemini Vision: "llm" | "none" | "mock"
LUCA_TAGGER_PROVIDER=none
LUCA_LLM_MODEL=gemini-4-hydrogen
LUCA_LLM_API_KEY=

# Límites de seguridad y gasto
LUCA_DAILY_BUDGET=5.0
LUCA_RATE_LIMIT=30/minute
LUCA_MAX_UPLOAD_BYTES=5242880
LUCA_VISION_TIMEOUT_SECONDS=15.0
