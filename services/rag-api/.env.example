# Configuración del servicio RAG (Java 21 + Spring Boot + PostgreSQL/pgvector)
# Copia este archivo a .env (ignorado por Git) para despliegue local o VPS.

PORT=8080
LUCA_RAG_DB_URL=jdbc:postgresql://localhost:5432/luca_rag
LUCA_RAG_DB_USER=luca
LUCA_RAG_DB_PASSWORD=cambia-esta-clave-en-produccion
LUCA_RAG_JWT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres-aqui
LUCA_RAG_JWT_EXPIRATION_SECONDS=86400
LUCA_RAG_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Proveedor de embeddings: auto | openai | ollama | local
# En 'auto': usa OpenAI si existe LUCA_OPENAI_API_KEY; si no, usa el proveedor local determinista.
LUCA_RAG_EMBEDDING_PROVIDER=auto
LUCA_RAG_EMBEDDING_DIMENSIONS=1536

# MVP con OpenAI Embeddings (opcional)
LUCA_OPENAI_API_KEY=
LUCA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Etapa posterior con proveedor local (opcional)
LUCA_OLLAMA_BASE_URL=http://127.0.0.1:11434
LUCA_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
